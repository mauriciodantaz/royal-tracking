# Royal Tracking — self-hosted
# Nunca commitar .env com secrets reais.

# Postgres EXTERNO (stack separada na RoyalNet)
# Naming: user/db = royaltracking_<slug>  host = serviço Swarm do Postgres
DATABASE_URL=postgresql://royaltracking_royalserver:CHANGE_ME_PASSWORD@postgres:5432/royaltracking_royalserver

# Crypto para tokens Meta/GA4 no banco (min 16 chars; use 32+ aleatórios)
ENCRYPTION_KEY=

# Auth.js
AUTH_SECRET=
NEXTAUTH_URL=https://tracking.royalserver.com.br

# Admin seed no primeiro boot (só cria se a tabela users estiver vazia)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=https://tracking.royalserver.com.br
NODE_ENV=production
PORT=3000

# OAuth apps (Integrações) — opcional por stack no Portainer
# RDSTATION_CRM_CLIENT_ID=
# RDSTATION_CRM_CLIENT_SECRET=
# RDSTATION_MKT_CLIENT_ID=
# RDSTATION_MKT_CLIENT_SECRET=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# Redirect: https://<DOMAIN>/api/integrations/<provider>/oauth/callback
