# Royal Tracking — self-hosted
# Nunca commitar .env com secrets reais.

# Postgres EXTERNO (stack separada na mesma rede Swarm, ex. RoyalNet)
# HOST = nome do serviço Postgres na Swarm (como no n8n: DB_POSTGRESDB_HOST)
DATABASE_URL=postgresql://tracking:CHANGE_ME_PASSWORD@postgres:5432/tracking

# Crypto para tokens Meta/GA4 no banco (min 16 chars; use 32+ aleatórios)
ENCRYPTION_KEY=

# Auth.js
AUTH_SECRET=
NEXTAUTH_URL=https://tracking.royalserver.com.br
# AUTH_URL=https://tracking.royalserver.com.br

# Admin seed no primeiro boot (só cria se a tabela users estiver vazia)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=https://tracking.royalserver.com.br
NODE_ENV=production
PORT=3000
