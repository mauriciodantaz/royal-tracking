# Royal Tracking — self-hosted
# Nunca commitar .env com secrets reais.

# Postgres (obrigatório)
DATABASE_URL=postgresql://tracking:changeme@postgres:5432/tracking

# Crypto para tokens Meta/GA4 no banco (min 16 chars; use 32+ aleatórios)
ENCRYPTION_KEY=

# Auth.js
AUTH_SECRET=
NEXTAUTH_URL=https://tracking.example.com
# Alias opcional (Auth.js v5 também lê AUTH_URL)
# AUTH_URL=https://tracking.example.com

# Admin seed no primeiro boot (só cria se a tabela users estiver vazia)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# App
NEXT_PUBLIC_APP_URL=https://tracking.example.com
NODE_ENV=production
PORT=3000
