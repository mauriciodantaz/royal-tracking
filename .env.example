# Royal Tracking — self-hosted
# Nunca commitar .env com secrets reais.
# Produção: env fica no YAML Portainer (ops/stack.yml), não no volume.

# ---------------------------------------------------------------------------
# Banco
# ---------------------------------------------------------------------------
# Postgres EXTERNO (stack separada; rede Swarm da VPS)
# Instância atual: user/db = royaltracking_dev (legado; manter se o banco já existe)
DATABASE_URL=postgresql://royaltracking_dev:CHANGE_ME_PASSWORD@postgres:5432/royaltracking_dev

# ---------------------------------------------------------------------------
# Crypto / Auth.js
# ---------------------------------------------------------------------------
# Crypto para tokens Meta/GA4 no banco (min 16 chars; use 32+ aleatórios)
ENCRYPTION_KEY=
AUTH_SECRET=
NEXTAUTH_URL=https://tracking.royalgrowth.com.br

# ---------------------------------------------------------------------------
# Super admin (imutável — só stack; não altera senha na UI)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP (convite, recuperação de senha, alertas de integração)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Royal Tracking <noreply@example.com>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://tracking.royalgrowth.com.br
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
TZ=America/Sao_Paulo

# Apex da marca: aceita este host e qualquer subdomínio (lp., www., mkt., …).
# Vírgula para vários apex. Vazio = não filtra (só use em dev).
ALLOWED_EVENT_DOMAINS=royalgrowth.com.br

# OAuth apps (Integrações) — opcional por stack no Portainer
# Legacy fallback — prefer Client ID/Secret na UI (Integrações → RD CRM/MKT)
# RDSTATION_CRM_CLIENT_ID=
# RDSTATION_CRM_CLIENT_SECRET=
# RDSTATION_MKT_CLIENT_ID=
# RDSTATION_MKT_CLIENT_SECRET=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# Redirect: https://tracking.royalgrowth.com.br/api/integrations/<provider>/oauth/callback
