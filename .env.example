# Royal Tracking — self-hosted
# Nunca commitar .env com secrets reais.
# Produção OSS: env fica no YAML Portainer (deploy/royal-tracking-stack.yml).
#
# Naming: stack / volume / DB / user = royaltracking_<slug>
# Título HTML: "{PROJECT_NAME} | Royal Tracking"

# ---------------------------------------------------------------------------
# Identidade da instância
# ---------------------------------------------------------------------------
# Nome de exibição (título das páginas). Slug da stack = slugify(PROJECT_NAME).
# Ex.: PROJECT_NAME=Fizzing → stack royaltracking_fizzing → título "Fizzing | Royal Tracking"
PROJECT_NAME=Dev

# ---------------------------------------------------------------------------
# Postgres (externo na RoyalNet — padrão n8n)
# ---------------------------------------------------------------------------
# user/db = royaltracking_<slug> (ex.: royaltracking_dev)
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=royaltracking_dev
DB_POSTGRESDB_PASSWORD=CHANGE_ME_PASSWORD
DB_POSTGRESDB_DATABASE=royaltracking_dev
# Fallback legado (só se as vars acima não existirem):
# DATABASE_URL=postgresql://royaltracking_dev:CHANGE_ME_PASSWORD@postgres:5432/royaltracking_dev

# ---------------------------------------------------------------------------
# Crypto / Auth.js
# ---------------------------------------------------------------------------
# Crypto para tokens Meta/GA4 no banco (min 16 chars; use 32+ aleatórios)
ENCRYPTION_KEY=
AUTH_SECRET=
NEXTAUTH_URL=https://tracking.royalgrowth.com.br
# Avançado (opcional) — GA4 FPID já usa ENCRYPTION_KEY; cookie _rt_fpid é host-only.
# GA_CLIENT_ID_SECRET=
# GA_FPID_COOKIE_DOMAIN=.tracking.example.com


# ---------------------------------------------------------------------------
# Super admin (imutável — só stack; não altera senha na UI)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# SMTP (convite, recuperação de senha, alertas de integração)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Royal Tracking <noreply@example.com>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://tracking.royalgrowth.com.br
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
TZ=America/Sao_Paulo

# Apex da marca: aceita este host e qualquer subdomínio (lp., www., mkt., …).
# Vírgula para vários apex. Vazio = não filtra (só use em dev).
ALLOWED_EVENT_DOMAINS=royalgrowth.com.br

# OAuth apps (Integrações) — opcional por stack no Portainer
# Legacy fallback — prefer Client ID/Secret na UI (Integrações → RD CRM/MKT)
# RDSTATION_CRM_CLIENT_ID=
# RDSTATION_CRM_CLIENT_SECRET=
# RDSTATION_MKT_CLIENT_ID=
# RDSTATION_MKT_CLIENT_SECRET=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# Redirect: https://tracking.royalgrowth.com.br/api/integrations/<provider>/oauth/callback
